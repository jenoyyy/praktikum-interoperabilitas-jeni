{
  "info": {
    "_postman_id": "6e4f92c1-95d2-4b90-8a15-3d07a7d0a001",
    "name": "Praktikum Interoperabilitas - Blog API",
    "description": "Pengujian manual Register, Login, Profile, BREAD Blog, token abilities, dan pemeriksaan kepemilikan blog. Jalankan request berurutan melalui Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "blogId",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "otherUserId",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register owner account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'jeni.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains registered user', function () { pm.expect(body.user).to.have.property('id'); pm.expect(body.user.role).to.eql('user'); });",
                  "pm.collectionVariables.set('userId', String(body.user.id));",
                  "pm.collectionVariables.set('email', body.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jeni\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Login owner with manage ability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Token has all BREAD abilities', function () { pm.expect(body.abilities).to.include.members(['blogs:read', 'blogs:create', 'blogs:update', 'blogs:delete']); });",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"mode\": \"manage\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Get owner profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Profile belongs to registered owner', function () { pm.expect(String(body.user.id)).to.eql(pm.collectionVariables.get('userId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/profile"
          }
        }
      ]
    },
    {
      "name": "02 - Blog BREAD",
      "item": [
        {
          "name": "B - Browse blogs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Browse returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains a data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/blogs"
          }
        },
        {
          "name": "A - Add blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Add returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Server assigns the authenticated user as owner', function () { pm.expect(String(body.data.user_id)).to.eql(pm.collectionVariables.get('userId')); });",
                  "pm.collectionVariables.set('blogId', String(body.data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Blog Uji Postman\",\n  \"content\": \"Blog ini dibuat untuk menguji endpoint BREAD.\",\n  \"user_id\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/blogs"
          }
        },
        {
          "name": "R - Read own blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Read returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returned blog matches saved blog ID', function () { pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('blogId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        },
        {
          "name": "E - Edit own blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Edit returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Blog title is updated', function () { pm.expect(pm.response.json().data.title).to.eql('Blog Uji Postman - Diperbarui'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Blog Uji Postman - Diperbarui\",\n  \"content\": \"Konten blog sudah diperbarui melalui Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        }
      ]
    },
    {
      "name": "03 - Owner Access Control",
      "item": [
        {
          "name": "Register second user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('otherEmail', 'pengguna-lain.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Second registration returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('otherUserId', String(body.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pengguna Lain\",\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Login second user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Second login returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('otherToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{password}}\",\n  \"mode\": \"manage\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Other user cannot read owner's blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reading another user blog returns 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        },
        {
          "name": "Other user cannot edit owner's blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Editing another user blog returns 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Percobaan mengubah blog orang lain\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        },
        {
          "name": "Other user cannot delete owner's blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleting another user blog returns 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Finish",
      "item": [
        {
          "name": "Owner deletes own blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Deleted blog ID matches', function () { pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('blogId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/blog/{{blogId}}"
          }
        },
        {
          "name": "Logout owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.unset('token');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/logout"
          }
        }
      ]
    }
  ]
}
